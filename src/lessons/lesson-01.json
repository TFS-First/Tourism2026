            "indicatorAr": "يختص بالعاقل والأشخاص والآلهة",
            "subPoints": [
              {
                "label": "1. Direction to Persons (الاتجاه نحو العاقل)",
                "text": "to a person or deity",
                "examples": [
                  {
                    "h": "𓈖 𓊃*𓀀",
                    "trans": "n s",
                    "mean": "to a man"
                  },
                  {
                    "h": "𓈖 𓊪:𓏏*𓎛",
                    "trans": "n Ptḥ",
                    "mean": "to Ptah"
                  }
                ]
              },
              {
                "label": "2. Dative of Interest (المفعول لأجله)",
                "text": "for, on behalf of",
                "examples": [
                  {
                    "h": "𓈖 𓇋*𓏏*𓀀",
                    "trans": "n ỉt",
                    "mean": "for the father"
                  },
                  {
                    "h": "𓈖 𓊃:𓏏*𓁐",
                    "trans": "n st",
                    "mean": "for a woman"
                  }
                ]
              }
            ]
          },
          {
            "num": "3",
            "titleEn": "The Preposition 'r' (𓂋): to, towards, into (To Places / Things)",
            "descEn": "Denotes motion or direction toward places, celestial bodies, and inanimate things:",
            "indicatorAr": "يختص بالأماكن والجمادات والاتجاهات",
            "subPoints": [
              {
                "label": "1. Direction to Places (الاتجاه نحو الأماكن)",
