                    "h": "𓂋 𓈙:𓈘",
                    "trans": "r š",
                    "mean": "to a lake"
                  },
                  {
                    "h": "𓂋 𓊪:𓏏*𓇯",
                    "trans": "r pt",
                    "mean": "to the sky"
                  }
                ]
